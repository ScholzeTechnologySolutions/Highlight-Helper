{
  "manifest_version": 3,
  "name": "Reading Highlighter",
  "version": "1.0",
  "description": "JS + CSS Reading Highlighter)",
  "permissions": ["activeTab"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Toggle Reading Highlighter"
  }
}